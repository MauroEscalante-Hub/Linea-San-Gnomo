[sub_resource type="GDScript" id="GDScript_b6pww"]
script/source = "extends Node2D

@onready var timer= $Timer
@onready var botones= $CanvasLayer/Control
func _ready() -> void:
	await get_tree().create_timer(2).timeout



func _on_button_reinicio_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Escenas/grayboxing/grayboxing_escenario1.tscn\")


func _on_button_salir_pressed() -> void:
	get_tree().quit()
"

