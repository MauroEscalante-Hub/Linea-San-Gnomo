[gd_scene format=4 uid="uid://b556pb1u0reub"]

[ext_resource type="Texture2D" uid="uid://dtdga0l1rlsns" path="res://Assets/models/DerrotaAuto.jpg" id="1_b6pww"]

[sub_resource type="GDScript" id="GDScript_b6pww"]
script/source = "extends Node2D

@onready var auto_explota= $explota
var escena=GameManager.escenaactual
func _ready() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	auto_explota.play()

func _on_button_reinicio_pressed() -> void:
	Metrics._save_current_session()
	Metrics._reset_active_metrics()
	if escena==1:
		get_tree().change_scene_to_file(\"res://Escenas/escenarios/nivel1_mapa1.tscn\")
	else:
		get_tree().change_scene_to_file(\"res://Escenas/escenarios/nivel1_mapa2/nivel1_mapa2.tscn\")
func _on_button_salir_pressed() -> void:
	Metrics.export_to_csv()
	get_tree().change_scene_to_file(\"res://menu_principal.tscn\")
"

